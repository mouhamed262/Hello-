<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>موقع خاص</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #fce7f3, #fbcfe8, #f472b6);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /* الصفحة الأولى (شاشة الدخول) */
        #welcome-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #831843, #be185d, #db2777);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 100;
            transition: opacity 0.8s ease, visibility 0.8s;
        }

        #welcome-screen.hidden {
            opacity: 0;
            visibility: hidden;
        }

        .open-btn {
            padding: 18px 45px;
            font-size: 1.8rem;
            font-weight: bold;
            color: #831843;
            background: linear-gradient(45deg, #fef08a, #fef08a, #fef9c3);
            border: 2px solid #facc15;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            letter-spacing: 2px;
        }

        .open-btn:hover {
            transform: scale(1.08);
            box-shadow: 0 15px 30px rgba(0,0,0,0.4);
        }

        /* الحاوية الرئيسية للخيارات */
        .container {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            padding: 30px 20px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(190, 24, 93, 0.2);
            text-align: center;
            width: 90%;
            max-width: 380px;
            border: 2px solid #fbcfe8;
        }

        .options-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 10px;
        }

        .option-btn {
            padding: 20px;
            font-size: 1.5rem;
            font-weight: bold;
            color: #9d174d;
            background: #fff;
            border: 2px solid #f472b6;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .option-btn:hover {
            background: #fdf2f8;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(244, 114, 182, 0.3);
        }

        /* نافذة الرسالة */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
            z-index: 50;
        }

        .modal.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-content {
            background: #ffffff;
            padding: 30px;
            border-radius: 20px;
            text-align: center;
            max-width: 320px;
            width: 85%;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            position: relative;
            animation: popup 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes popup {
            from { transform: scale(0.8); }
            to { transform: scale(1); }
        }

        .modal-content h3 {
            color: #9d174d;
            font-size: 1.6rem;
            margin-bottom: 15px;
        }

        .flower-click-btn {
            font-size: 3.5rem;
            background: none;
            border: none;
            cursor: pointer;
            margin: 15px 0;
            transition: transform 0.2s ease;
            display: inline-block;
        }

        .flower-click-btn:hover {
            transform: scale(1.2) rotate(10deg);
        }

        .sorry-text {
            font-size: 1.8rem;
            font-weight: bold;
            color: #be185d;
            margin-top: 15px;
            display: none;
            animation: fadeIn 0.8s ease forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .close-btn {
            position: absolute;
            top: 10px;
            left: 15px;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #94a3b8;
            cursor: pointer;
        }

        /* تساقط الورود */
        .falling-flower {
            position: fixed;
            top: -50px;
            font-size: 24px;
            user-select: none;
            pointer-events: none;
            z-index: 1000;
            animation: fall linear forwards;
        }

        @keyframes fall {
            to {
                transform: translateY(105vh) rotate(360deg);
            }
        }
    </style>
</head>
<body>

    <!-- الشاشة الأولى -->
    <div id="welcome-screen">
        <button class="open-btn" onclick="openMainPage()">OPEN</button>
    </div>

    <!-- الصفحة الرئيسية - الخانات 1 2 3 -->
    <div class="container">
        <div class="options-list">
            <button class="option-btn" onclick="openMessage(1)">1</button>
            <button class="option-btn" onclick="openMessage(2)">2</button>
            <button class="option-btn" onclick="openMessage(3)">3</button>
        </div>
    </div>

    <!-- النافذة المنبثقة للرسالة -->
    <div class="modal" id="message-modal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeMessage()">&times;</button>
            <h3>مرحباً</h3>
            <p style="color: #64748b;">اضغط على الوردة</p>
            
            <button class="flower-click-btn" onclick="triggerFlowerRain()">🌹</button>
            
            <div class="sorry-text" id="sorry-text">I'm sorry</div>
        </div>
    </div>

    <script>
        function openMainPage() {
            document.getElementById('welcome-screen').classList.add('hidden');
        }

        function openMessage(number) {
            // إعادة ضبط النافذة عند فتحها
            document.getElementById('sorry-text').style.display = 'none';
            document.getElementById('message-modal').classList.add('active');
        }

        function closeMessage() {
            document.getElementById('message-modal').classList.remove('active');
        }

        function triggerFlowerRain() {
            // إظهار نص الاعتذار
            document.getElementById('sorry-text').style.display = 'block';

            // إنشاء تساقط الورود الوردي والأحمر
            const flowers = ['🌹', '🌸', '🌺', '🌷'];
            for (let i = 0; i < 35; i++) {
                setTimeout(() => {
                    const flower = document.createElement('div');
                    flower.classList.add('falling-flower');
                    flower.innerText = flowers[Math.floor(Math.random() * flowers.length)];
                    
                    flower.style.left = Math.random() * 100 + 'vw';
                    flower.style.animationDuration = Math.random() * 2 + 3 + 's';
                    flower.style.fontSize = Math.random() * 20 + 20 + 'px';
                    
                    document.body.appendChild(flower);

                    setTimeout(() => {
                        flower.remove();
                    }, 5000);
                }, i * 100);
            }
        }
    </script>
</body>
</html>
